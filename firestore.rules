rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admins: documento admins/{email} creado a mano desde la consola.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function rateDoc(uid) {
      return /databases/$(database)/documents/rateLimits/$(uid);
    }

    // Ciudades donde funciona Huecazo. Agregar o activar una ciudad = crear/editar su documento
    // desde el panel admin; estas reglas no necesitan cambios.
    match /cities/{cityId} {
      function validBounds(b) {
        // Rectángulo dentro del Perú (con margen).
        return b is map && b.keys().hasAll(['north', 'south', 'east', 'west'])
          && b.north is number && b.south is number && b.east is number && b.west is number
          && b.north > b.south && b.east > b.west
          && b.north <= 0.1 && b.south >= -18.6 && b.east <= -68.4 && b.west >= -81.5;
      }

      function validCity() {
        let c = request.resource.data;
        return c.keys().hasOnly(['name', 'department', 'enabled', 'bounds', 'viewBounds', 'center',
                                  'order', 'createdAt', 'updatedAt'])
          && c.keys().hasAll(['name', 'enabled', 'bounds', 'viewBounds', 'center', 'order'])
          && c.name is string && c.name.size() > 0 && c.name.size() <= 60
          && (!('department' in c) || (c.department is string && c.department.size() <= 40))
          && c.enabled is bool
          && c.order is number
          && validBounds(c.bounds) && validBounds(c.viewBounds)
          && c.center.lat is number && c.center.lng is number
          && cityId.matches('^[a-z0-9-]{1,50}$');
      }

      allow read: if true;
      allow create, update: if isAdmin() && validCity();
      // Para dejar de recibir reportes en una ciudad se pausa (enabled = false), no se borra.
      allow delete: if false;
    }

    // Perfil público para el ranking: solo alias + emoji (nunca nombre ni correo).
    match /profiles/{uid} {
      function validProfile() {
        let p = request.resource.data;
        return p.keys().hasOnly(['alias', 'emoji', 'updatedAt'])
          && p.keys().hasAll(['alias', 'emoji', 'updatedAt'])
          && p.alias is string && p.alias.matches('^[\\p{L}\\p{N} _.-]{3,20}$')
          && p.emoji is string && p.emoji.size() >= 1 && p.emoji.size() <= 8
          && p.updatedAt == request.time;
      }

      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid && validProfile();
      // El dueño puede salir del ranking; el admin puede quitar un alias ofensivo.
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // Las confirmaciones (solo la fecha; el id es el uid anónimo) son públicas para calcular los puntos.
    match /{path=**}/confirmations/{uid} {
      allow read: if true;
    }

    // Traspaso de reportes de una sesión anónima a una cuenta de Google ya existente.
    // 1) El anónimo crea transfers/{uidAnonimo} con un código secreto (solo él puede leerlo).
    // 2) Ya con Google, la cuenta destino se asigna como `to` probando que conoce el código.
    // 3) La cuenta destino reclama los reportes del anónimo (ver isTransferClaim en /reports).
    match /transfers/{fromUid} {
      function freshRequest() {
        return request.resource.data.keys().hasOnly(['code', 'createdAt'])
          && request.resource.data.code is string && request.resource.data.code.size() >= 32
          && request.resource.data.createdAt == request.time;
      }

      allow read: if signedIn() && request.auth.uid == fromUid;
      // El anónimo crea (o renueva) su autorización.
      allow create: if signedIn() && request.auth.uid == fromUid
        && request.auth.token.firebase.sign_in_provider == 'anonymous' && freshRequest();
      allow update: if signedIn() && (
        (request.auth.uid == fromUid
          && request.auth.token.firebase.sign_in_provider == 'anonymous' && freshRequest())
        // La cuenta destino (no anónima) acepta el traspaso dentro de 10 minutos.
        || (request.auth.uid != fromUid
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && !('to' in resource.data)
          && resource.data.createdAt > request.time - duration.value(10, 'm')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['to', 'proof'])
          && request.resource.data.to == request.auth.uid
          && request.resource.data.proof == resource.data.code)
      );
      allow delete: if false;
    }

    match /admins/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // Un reporte cada 2 minutos por usuario (anónimo o Google).
    match /rateLimits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastReportAt'])
        && request.resource.data.lastReportAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastReportAt'])
        && request.resource.data.lastReportAt == request.time
        && resource.data.lastReportAt < request.time - duration.value(2, 'm');
    }

    match /reports/{reportId} {
      function reportPath() {
        return /databases/$(database)/documents/reports/$(reportId);
      }

      function confirmationPath(uid) {
        return /databases/$(database)/documents/reports/$(reportId)/confirmations/$(uid);
      }

      function cityPath(id) {
        return /databases/$(database)/documents/cities/$(id);
      }

      // El punto debe caer dentro de la zona de una ciudad activa.
      function inCityZone(city, d) {
        return city.enabled == true
          && d.lat >= city.bounds.south && d.lat <= city.bounds.north
          && d.lng >= city.bounds.west && d.lng <= city.bounds.east;
      }

      // Zona original de Tacna: solo se usa mientras no exista el documento cities/tacna.
      function inLegacyTacna(d) {
        return d.lat > -18.6 && d.lat < -16.9 && d.lng > -71.1 && d.lng < -69.4;
      }

      // Compatibilidad: las versiones antiguas de la app (PWA en caché) no envían cityId → se tratan como Tacna.
      function cityOk(d) {
        let id = ('cityId' in d) ? d.cityId : 'tacna';
        return id is string
          && (exists(cityPath(id))
                ? inCityZone(get(cityPath(id)).data, d)
                : (id == 'tacna' && inLegacyTacna(d)));
      }

      function validNewReport() {
        let d = request.resource.data;
        let required = ['lat', 'lng', 'geohash', 'photos', 'severity', 'note', 'status',
                        'confirmations', 'reporterUid', 'address', 'createdAt', 'updatedAt'];
        return d.keys().hasOnly(required.concat(['cityId'])) && d.keys().hasAll(required)
          && d.lat is number && d.lng is number
          && cityOk(d)
          && d.geohash is string && d.geohash.size() >= 7 && d.geohash.size() <= 12
          && d.photos is list && d.photos.size() >= 1 && d.photos.size() <= 2
          && d.severity in ['pequeno', 'mediano', 'peligroso']
          && d.note is string && d.note.size() <= 280
          && d.status == 'pendiente'
          && d.confirmations == 0
          && d.reporterUid == request.auth.uid
          && (d.address == null || (d.address is string && d.address.size() <= 200))
          && d.createdAt == request.time
          && d.updatedAt == request.time;
      }

      function isAdminStatusChange() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['pendiente', 'verificado', 'reparado', 'rechazado']
          && request.resource.data.updatedAt == request.time;
      }

      // "Sigue ahí": +1 confirmación, una sola vez por usuario.
      function isConfirmation() {
        return signedIn()
          // Nadie puede confirmar su propio reporte (daría puntos en el ranking).
          && resource.data.reporterUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmations', 'lastConfirmedAt'])
          && request.resource.data.confirmations == resource.data.confirmations + 1
          && request.resource.data.lastConfirmedAt == request.time
          && !exists(confirmationPath(request.auth.uid))
          && existsAfter(confirmationPath(request.auth.uid));
      }

      allow read: if true;
      allow create: if signedIn() && validNewReport()
        && getAfter(rateDoc(request.auth.uid)).data.lastReportAt == request.time;
      // Reportes creados antes de existir las ciudades: el admin les asigna su ciudad una sola vez.
      function isAdminCityBackfill() {
        return isAdmin()
          && !('cityId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cityId'])
          && exists(cityPath(request.resource.data.cityId));
      }

      // La cuenta destino de un traspaso aceptado reclama los reportes del anónimo (solo cambia el autor).
      function isTransferClaim() {
        let transferPath = /databases/$(database)/documents/transfers/$(resource.data.reporterUid);
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reporterUid'])
          && request.resource.data.reporterUid == request.auth.uid
          && exists(transferPath)
          && get(transferPath).data.get('to', '') == request.auth.uid;
      }

      allow update: if isAdminStatusChange() || isConfirmation() || isAdminCityBackfill() || isTransferClaim();
      allow delete: if isAdmin();

      match /confirmations/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(reportPath()).data.confirmations == get(reportPath()).data.confirmations + 1;
      }
    }
  }
}
